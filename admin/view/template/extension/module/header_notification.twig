{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-header-notification" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-bullhorn"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-header-notification" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_header_notification_status" id="input-status" class="form-control">
                {% if module_header_notification_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_show_categories }}</label>
            <div class="col-sm-10">
              <input type="checkbox" name="module_header_notification_show_categories" value="1" {% if module_header_notification_show_categories %}checked="checked"{% endif %} />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_show_manufacturers }}</label>
            <div class="col-sm-10">
              <input type="checkbox" name="module_header_notification_show_manufacturers" value="1" {% if module_header_notification_show_manufacturers %}checked="checked"{% endif %} />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_show_products }}</label>
            <div class="col-sm-10">
              <input type="checkbox" name="module_header_notification_show_products" value="1" {% if module_header_notification_show_products %}checked="checked"{% endif %} />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_show_new_products }}</label>
            <div class="col-sm-10">
              <input type="checkbox" name="module_header_notification_show_new_products" value="1" {% if module_header_notification_show_new_products %}checked="checked"{% endif %} />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_custom_items }}</label>
            <div class="col-sm-10">
              <table id="custom-items" class="table table-striped table-bordered table-hover">
                <thead>
                  <tr>
                    <th>{{ entry_custom_label }}</th>
                    <th>{{ entry_custom_value }}</th>
                    <th>{{ entry_custom_enabled }}</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {% set custom_row = 0 %}
                  {% for item in module_header_notification_custom_items %}
                    <tr id="custom-item-row{{ custom_row }}">
                      <td><input type="text" name="module_header_notification_custom_items[{{ custom_row }}][label]" value="{{ item.label }}" class="form-control" /></td>
                      <td><input type="text" name="module_header_notification_custom_items[{{ custom_row }}][value]" value="{{ item.value }}" class="form-control" /></td>
                      <td class="text-center">
                        <input type="checkbox" name="module_header_notification_custom_items[{{ custom_row }}][enabled]" value="1" {% if item.enabled %}checked="checked"{% endif %} />
                      </td>
                      <td class="text-right">
                        <button type="button" class="btn btn-danger btn-xs" onclick="$('#custom-item-row{{ custom_row }}').remove();">{{ text_remove }}</button>
                      </td>
                    </tr>
                    {% set custom_row = custom_row + 1 %}
                  {% endfor %}
                </tbody>
              </table>
              <button type="button" id="add-custom-item" class="btn btn-default btn-sm">{{ text_add }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}

<script type="text/javascript">
var custom_row = {{ custom_row|default(0) }};
$('#add-custom-item').on('click', function() {
  var html = '';
  html += '<tr id="custom-item-row' + custom_row + '">';
  html += '  <td><input type="text" name="module_header_notification_custom_items[' + custom_row + '][label]" value="" class="form-control" /></td>';
  html += '  <td><input type="text" name="module_header_notification_custom_items[' + custom_row + '][value]" value="" class="form-control" /></td>';
  html += '  <td class="text-center"><input type="checkbox" name="module_header_notification_custom_items[' + custom_row + '][enabled]" value="1" checked="checked" /></td>';
  html += '  <td class="text-right"><button type="button" class="btn btn-danger btn-xs" onclick="$(\\'#custom-item-row' + custom_row + '\\').remove();">{{ text_remove }}</button></td>';
  html += '</tr>';
  $('#custom-items tbody').append(html);
  custom_row++;
});
</script>
