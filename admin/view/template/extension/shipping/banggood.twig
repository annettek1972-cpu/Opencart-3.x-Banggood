{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-banggood" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-truck"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-banggood" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_banggood_status" id="input-status" class="form-control">
                {% if shipping_banggood_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-cache-days">{{ entry_cache_days }}</label>
            <div class="col-sm-10">
              <input type="number" min="1" max="365" name="shipping_banggood_cache_days" value="{{ shipping_banggood_cache_days }}" id="input-cache-days" class="form-control" />
              <span class="help-block">{{ help_cache_days }}</span>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_banggood_sort_order" value="{{ shipping_banggood_sort_order }}" placeholder="0" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-flask"></i> {{ text_test_shipments }}</h3>
      </div>
      <div class="panel-body">
        <div class="row">
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label" for="bg-test-product-id">{{ entry_test_product_id }}</label>
              <input type="text" id="bg-test-product-id" class="form-control" placeholder="1812604" />
            </div>
          </div>
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label" for="bg-test-country">{{ entry_test_country }}</label>
              <input type="text" id="bg-test-country" class="form-control" placeholder="Australia / AU" />
            </div>
          </div>
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label" for="bg-test-warehouse">{{ entry_test_warehouse }}</label>
              <input type="text" id="bg-test-warehouse" class="form-control" placeholder="CN / US" />
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label" for="bg-test-poa">{{ entry_test_poa_id }}</label>
              <input type="text" id="bg-test-poa" class="form-control" placeholder="optional" />
            </div>
          </div>
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label" for="bg-test-qty">{{ entry_test_quantity }}</label>
              <input type="number" min="1" id="bg-test-qty" class="form-control" value="1" />
            </div>
          </div>
          <div class="col-sm-4">
            <label class="control-label">&nbsp;</label>
            <div>
              <button type="button" id="bg-test-shipments" class="btn btn-primary">{{ button_test_shipments }}</button>
            </div>
          </div>
        </div>
        <pre id="bg-test-output" style="margin-top:12px;display:none;max-height:300px;overflow:auto;"></pre>
      </div>
    </div>
  </div>
</div>
{{ footer }}

<script type="text/javascript">
var bgTestShipmentsUrl = '{{ test_shipments_url|default(('index.php?route=extension/shipping/banggood/testShipments&user_token=' ~ user_token))|raw }}'.replace(/&amp;/g, '&');
$('#bg-test-shipments').on('click', function() {
  var $btn = $(this);
  var $out = $('#bg-test-output');
  $out.hide().text('');
  $btn.prop('disabled', true);
  $.ajax({
    url: bgTestShipmentsUrl,
    type: 'post',
    dataType: 'json',
    data: {
      product_id: $('#bg-test-product-id').val(),
      country: $('#bg-test-country').val(),
      warehouse: $('#bg-test-warehouse').val(),
      poa_id: $('#bg-test-poa').val(),
      quantity: $('#bg-test-qty').val()
    },
    success: function(json) {
      var text = JSON.stringify(json, null, 2);
      $out.text(text).show();
    },
    error: function(xhr) {
      var msg = xhr && xhr.responseText ? xhr.responseText : 'Request failed';
      $out.text(msg).show();
    },
    complete: function() {
      $btn.prop('disabled', false);
    }
  });
});
</script>
