<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>Header Notification Banner</name>
    <code>header_notification_banner</code>
    <version>1.0</version>
    <author>Cursor</author>
    <file path="catalog/controller/common/header.php">
        <operation>
            <search><![CDATA[return $this->load->view('common/header', $data);]]></search>
            <add position="before"><![CDATA[
        if (!isset($data['header_notification'])) {
            $data['header_notification'] = $this->load->controller('extension/module/header_notification');
        }
]]></add>
        </operation>
    </file>
    <file path="catalog/view/theme/so-megastore/template/common/header.twig">
        <operation>
            <search><![CDATA[
<body class="{{cls_body}}">]]></search>
            <add position="after"><![CDATA[
{{ header_notification|raw }}
]]></add>
        </operation>
    </file>
</modification>
